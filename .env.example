# Copy this file to .env and fill in values to enable cloud saves via Firebase Realtime Database
# If not provided, the game will save locally to savegame.dat as before.

# Choose backend: auto | firebase | local (auto uses firebase if FIREBASE_DB_URL is set)
CLOUD_BACKEND=auto

# Firebase Realtime Database base URL, e.g. https://your-project-id.firebaseio.com
FIREBASE_DB_URL=

# Optional path namespace inside the database
FIREBASE_PATH=/moneySmarts/saves

# Optional auth: user ID token or database secret (if your DB rules require it)
FIREBASE_AUTH_TOKEN=

# Optional timeout for HTTP requests in seconds
FIREBASE_TIMEOUT=8

# Optional key name for your save slot; defaults derive from filename (savegame, savegame_slot1, etc.)
CLOUD_SAVE_KEY=
